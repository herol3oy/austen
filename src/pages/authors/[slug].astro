---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { loadLibrary } from '../../lib/library';
import { authorCollections } from '../../lib/authors';
import { breadcrumbData } from '../../lib/seo';
export async function getStaticPaths() {
  const { entries } = await loadLibrary();
  return authorCollections(entries).map(author => ({ params: { slug: author.slug }, props: { author } }));
}
const { author } = Astro.props;
const count = author.books.length.toLocaleString('en');
const description = `Explore ${count} published character relationship maps for books by ${author.name}, listed by title. Maps cover the whole book and include spoilers.`;
const base = import.meta.env.BASE_URL;
const breadcrumbs = [{ name: 'Home', href: base }, { name: 'Authors', href: `${base}authors/` }, { name: author.name, href: `${base}authors/${author.slug}/` }];
---
<BaseLayout title={`${author.name} Character Relationship Maps — Austen`} description={description} structuredData={[breadcrumbData(breadcrumbs, Astro.site!)]}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="library-intro">
    <p class="section-kicker">An author collection</p>
    <h1>{author.name} character relationship maps</h1>
    <p>{description}</p>
  </section>
  <section aria-labelledby="collection-heading">
    <div class="section-heading"><h2 id="collection-heading">Published maps</h2><span>{count} maps</span></div>
    <ul class="library-list">{author.books.map(book => <BookCard book={book} headingLevel="h3" />)}</ul>
  </section>
</BaseLayout>
<style>
  h1 { overflow-wrap: anywhere; }
</style>
