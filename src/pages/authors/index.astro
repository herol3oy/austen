---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { authorCollections } from '../../lib/authors'
import { loadLibrary } from '../../lib/library'

const { entries } = await loadLibrary()
const authors = authorCollections(entries)
---

<BaseLayout
	title="Authors and Character Relationship Maps — Austen"
	description={`Browse ${authors.length.toLocaleString('en')} authors with at least two published character relationship maps. Explore each author's collection by book title.`}
>
	<section class="library-intro">
		<p class="section-kicker">The relationship library</p>
		<h1>Authors and character relationship maps</h1>
		<p>
			Explore authors with at least two published maps. Each collection brings
			together the characters and connections in their books.
		</p>
		<p class="metadata-note">
			<a href={`${import.meta.env.BASE_URL}genres/`}>Browse by genre</a>
			<span aria-hidden="true"> · </span>
			<a href={`${import.meta.env.BASE_URL}eras/`}>Browse by era</a>
		</p>
	</section>
	<!-- biome-ignore lint/a11y/noRedundantRoles: Preserve Safari list semantics with list-style: none. -->
	<ul class="author-directory" role="list">
		{authors.map(author => <li><a href={`${import.meta.env.BASE_URL}authors/${author.slug}/`}>{author.name}</a><span class="metadata-note">{author.books.length.toLocaleString('en')} maps</span></li>)}
	</ul>
	{authors.length === 0 && <p>No author collections are available yet. <a href={`${import.meta.env.BASE_URL}maps/`}>Browse published maps</a>.</p>}
</BaseLayout>
<style>
.author-directory {
	display: grid;
	gap: 1rem 2rem;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
}
li {
	display: flex;
	flex-wrap: wrap;
	align-items: baseline;
	gap: 0.5rem 1rem;
	padding-block: 0.75rem;
	border-bottom: 1px solid var(--color-rule);
	overflow-wrap: anywhere;
	min-width: 0;
}
a {
	font-family: var(--font-display);
	font-size: 1.5rem;
}
</style>
