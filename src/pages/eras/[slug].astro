---
import BookCard from '../../components/BookCard.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { loadLibrary } from '../../lib/library'
import { breadcrumbData } from '../../lib/seo'
import { eraCollections } from '../../lib/taxonomy'
export async function getStaticPaths() {
	const { entries } = await loadLibrary()
	return eraCollections(entries).map((era) => ({
		params: { slug: era.slug },
		props: { era },
	}))
}
const { era } = Astro.props
const count = era.books.length.toLocaleString('en')
const description = `Explore ${count} published character relationship maps from the ${era.name}, listed by title. Maps cover the whole book and include spoilers.`
const base = import.meta.env.BASE_URL
const breadcrumbs = [
	{ name: 'Home', href: base },
	{ name: 'Eras', href: `${base}eras/` },
	{ name: era.name, href: `${base}eras/${era.slug}/` },
]
---

<BaseLayout
	title={`${era.name} Character Relationship Maps — Austen`}
	description={description}
	structuredData={[breadcrumbData(breadcrumbs, Astro.site!)]}
>
	<Breadcrumbs items={breadcrumbs} />
	<section class="library-intro">
		<p class="section-kicker">An era collection</p>
		<h1>{era.name} character relationship maps</h1>
		<p>{description}</p>
	</section>
	<section aria-labelledby="collection-heading">
		<div class="section-heading">
			<h2 id="collection-heading">Published maps</h2>
			<span>{count} maps</span>
		</div>
		<ul class="library-list">
			{era.books.map(book => <BookCard book={book} headingLevel="h3" />)}
		</ul>
	</section>
</BaseLayout>
<style>
h1 {
	overflow-wrap: anywhere;
}
</style>
