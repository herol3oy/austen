---
import { getImage } from 'astro:assets'
import { parseDiagram } from '../../../shared/diagram-policy.mjs'
import BookCard from '../../components/BookCard.astro'
import BookCover from '../../components/BookCover.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import DiagramWorkspace from '../../components/DiagramWorkspace.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
	authorCollections,
	collectionsForBook,
	relatedMaps,
} from '../../lib/authors'
import { coverAssetFor } from '../../lib/cover-assets'
import { loadLibrary } from '../../lib/library'
import { breadcrumbData } from '../../lib/seo'
export async function getStaticPaths() {
	const { maps, entries } = await loadLibrary()
	const authors = authorCollections(entries)
	return maps.map((map) => {
		try {
			const diagram = parseDiagram(map.revision.mermaid)
			return {
				params: { slug: map.book.slug },
				props: {
					map,
					diagram,
					authors: collectionsForBook(map.book, authors),
					related: relatedMaps(map.book, authors),
				},
			}
		} catch (cause) {
			throw new Error(`Could not parse published map for ${map.book.slug}`, {
				cause,
			})
		}
	})
}
const { map, diagram, authors, related } = Astro.props
const { book, revision, svg, review } = map
const automatic = review.mode === 'automatic'
const canonicalUrl = new URL(
	`${import.meta.env.BASE_URL}books/${book.slug}/`,
	Astro.site,
).href
const title = `${book.title} Character Relationship Map`
const listFormatter = new Intl.ListFormat('en', {
	style: 'long',
	type: 'conjunction',
})
const introNames = diagram.nodes.slice(0, 5).map((node) => node.label)
if (diagram.nodes.length > 5) introNames.push('the other major characters')
const description = `Explore the relationships between ${listFormatter.format(introNames)} in ${book.title} by ${listFormatter.format(book.authors)}.`
const names = new Map(diagram.nodes.map((node) => [node.id, node.label]))
const base = import.meta.env.BASE_URL
const authorLinks = new Map(
	authors.map((author) => [author.name, `${base}authors/${author.slug}/`]),
)
const source = coverAssetFor(book.coverSlug)
const cover = source
	? await getImage({ src: source, width: 720, format: 'jpeg', quality: 'mid' })
	: undefined
const socialImage = cover
	? {
			url: cover.src,
			width: Number(cover.attributes.width),
			height: Number(cover.attributes.height),
			type: 'image/jpeg',
			alt: `Cover of ${book.title}`,
		}
	: undefined
const breadcrumbs = [
	{ name: 'Home', href: base },
	{ name: 'Maps', href: `${base}maps/` },
	{ name: book.title, href: canonicalUrl },
]
const structuredData = [
	breadcrumbData(breadcrumbs, Astro.site!),
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		url: canonicalUrl,
		name: title,
		description,
		about: {
			'@type': 'Book',
			name: book.title,
			author: book.authors.map((name: string) => ({ '@type': 'Person', name })),
		},
	},
]
---

<BaseLayout
	title={`${title} — Austen`}
	description={description}
	canonicalUrl={canonicalUrl}
	socialImage={socialImage}
	structuredData={structuredData}
>
	<Breadcrumbs items={breadcrumbs} />
	<section class="library-intro book-intro">
		<div class="book-cover-link book-page-cover">
			<BookCover book={book} large />
		</div>
		<div class="book-intro-copy">
			<p class="section-kicker">
				{automatic ? 'An AI-generated relationship map' : 'A reviewed relationship map'}
			</p>
			<h1>{title}</h1>
			<p class="book-byline">
				{book.authors.map((name: string, index: number) => <Fragment>{index > 0 ? ', ' : ''}{authorLinks.has(name) ? <a href={authorLinks.get(name)}>{name}</a> : name}</Fragment>)}
				{` · ${book.year || "Year unknown"}`}
			</p>
			<p class="book-description">{description}</p>
			<p class="metadata-note">
				Map generated {revision.generatedAt.slice(0, 10)}{" · "}
				{automatic ? `Published ${review.publishedAt.slice(0, 10)}` : `Reviewed ${review.reviewedAt.slice(0, 10)} · ${review.reviewer}`}
			</p>
			<a
				class="book-read-link"
				href={book.ebookUrl}
				target="_blank"
				rel="noopener noreferrer"
			>
				Read the full book on Standard Ebooks
			</a>
		</div>
	</section>
	<p
		id="global-status"
		class="status-line"
		role="status"
		aria-live="polite"
	></p>
	<DiagramWorkspace
		svg={svg}
		showHeading={false}
		initial={{ book, mermaid: revision.mermaid, generatedAt: revision.generatedAt, canonicalUrl }}
	>
		<Fragment slot="after-diagram">
			<section class="book-details" aria-labelledby="key-characters-heading">
				<h2 id="key-characters-heading">Key characters</h2>
				<!-- biome-ignore lint/a11y/noRedundantRoles: Preserve Safari list semantics with list-style: none. -->
				<ul class="character-list" role="list">
					{diagram.nodes.map(node => <li>{node.label}</li>)}
				</ul>
			</section>
			<section class="book-details" aria-labelledby="key-relationships-heading">
				<h2 id="key-relationships-heading">Key relationships</h2>
				<dl class="relationship-list">
					{diagram.edges.map(edge => (
            <div>
              <dt>{names.get(edge.source)} → {names.get(edge.target)}</dt>
              <dd>{edge.label ?? 'Relationship unspecified'}</dd>
            </div>
          ))}
				</dl>
			</section>
		</Fragment>
	</DiagramWorkspace>
	{related.length > 0 && <section class="related-maps" aria-labelledby="related-heading">
    <div class="section-heading"><h2 id="related-heading">More by this author</h2></div>
    <ul class="library-list">{related.map(other => <BookCard book={other} headingLevel="h3" />)}</ul>
    {authors.map(author => <p><a href={authorLinks.get(author.name)}>Explore all {author.books.length.toLocaleString('en')} maps by {author.name} →</a></p>)}
  </section>}
</BaseLayout>

<style>
.book-byline {
	overflow-wrap: anywhere;
}
.related-maps {
	margin-top: 3rem;
}
.related-maps p {
	margin-top: 0.65rem;
	overflow-wrap: anywhere;
}
.book-description {
	max-width: 70ch;
	color: var(--color-ink-muted);
	overflow-wrap: anywhere;
}
.book-read-link {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	max-width: 100%;
	min-height: 44px;
	margin-top: 1rem;
	padding: 0.72rem 1.15rem;
	border: 1px solid var(--color-green);
	border-radius: var(--radius);
	background: var(--color-green);
	color: var(--color-surface);
	font-size: 0.75rem;
	font-weight: 600;
	letter-spacing: 0.02em;
	text-align: center;
	text-decoration: none;
	overflow-wrap: anywhere;
}
.book-read-link:hover {
	background: var(--color-green-dark);
}
.book-details {
	padding-top: 1.5rem;
	border-top: 1px solid var(--color-rule);
}
.book-details h2 {
	margin-bottom: 1rem;
	font-size: clamp(1.75rem, 3vw, 2.25rem);
}
.character-list,
.relationship-list {
	display: grid;
	gap: 0.75rem 2rem;
}
.character-list li,
.relationship-list > div {
	min-width: 0;
	overflow-wrap: anywhere;
}
.relationship-list {
	margin: 0;
	gap: 1.25rem 2rem;
}
.relationship-list dt {
	font-weight: 600;
}
.relationship-list dd {
	margin: 0.25rem 0 0;
	color: var(--color-ink-muted);
}
@media (min-width: 640px) {
	.character-list,
	.relationship-list {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}
</style>
