<section id="history-section">
  <div class="section-heading">
    <h2 id="history-heading" tabindex="-1">Recent volumes</h2>
    <span id="history-count" class="history-count"></span>
  </div>
  <div class="history-feedback">
    <p id="history-status" class="status-line" role="status" aria-live="polite"></p>
    <button id="history-undo-btn" class="history-undo" type="button" hidden>Undo</button>
  </div>
  <ul id="history-list" class="shelf"></ul>
</section>
