---
import type { CatalogEntry } from '../lib/library';
import BookCover from './BookCover.astro';
import { searchText } from '../../shared/books.mjs';
interface Props { book: CatalogEntry }
const { book } = Astro.props;
const href = book.publishedUrl || (book.eligible ? `${import.meta.env.BASE_URL}generate/?book=${encodeURIComponent(book.id)}` : null);
const CoverLink = href ? 'a' : 'div';
---
<li class="library-card" data-library-book data-search={searchText(`${book.title} ${book.authors.join(' ')} ${book.year || ''}`)}>
  <CoverLink class="book-cover-link" href={href || undefined}>
    <BookCover book={book}>
      <div class="book-cover-caption">
        <h2>{book.title}</h2>
        <p>{book.authors.join(', ') || 'Author unknown'}</p>
        <p class="book-cover-year">{book.year || 'unknown'}</p>
      </div>
    </BookCover>
  </CoverLink>
  <div class="availability">{href ? <a href={href}>{book.availability}<span aria-hidden="true"> →</span></a> : <span>{book.availability}</span>}</div>
</li>
