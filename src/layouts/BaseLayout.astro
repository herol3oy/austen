---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import '@fontsource/inter/latin-400.css'
import '@fontsource/inter/latin-500.css'
import '@fontsource/inter/latin-600.css'
import '@fontsource/cormorant-garamond/latin-400.css'
import '@fontsource/cormorant-garamond/latin-500.css'
import '@fontsource/cormorant-garamond/latin-600.css'
import '@fontsource/cormorant-garamond/latin-400-italic.css'
import cormorantGaramond600 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url'
import { serializeStructuredData } from '../lib/seo'

interface Props {
	title?: string
	description?: string
	canonicalUrl?: string
	robots?: string
	socialImage?: {
		url: string
		width: number
		height: number
		type: string
		alt: string
	}
	structuredData?: Record<string, unknown>[]
}
const {
	title = 'Austen — Character Relationship Maps for Books',
	description = 'Explore character relationship maps for books. Discover the connections between literary characters and create interactive maps of your own.',
	canonicalUrl,
	robots,
	socialImage,
	structuredData = [],
} = Astro.props
const base = import.meta.env.BASE_URL
const currentNav = (section: string) => {
	const href = `${base}${section}/`
	if (Astro.url.pathname === href) return 'page'
	if (Astro.url.pathname.startsWith(href)) return 'location'
	return undefined
}
const pageUrl = new URL(canonicalUrl || Astro.url.pathname, Astro.site).href
const preview = socialImage ?? {
	url: `${base}logo.png`,
	width: 1254,
	height: 1254,
	type: 'image/png',
	alt: 'Austen logo',
}
const socialImageUrl = new URL(preview.url, Astro.site).href
const socialImageAlt = preview.alt

const startYear = 2026
const currentYear = new Date().getFullYear()
const yearLabel =
	currentYear > startYear ? `${startYear}–${currentYear}` : `${startYear}`
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="color-scheme" content="light">
		<meta name="description" content={description}>
		{robots && <meta name="robots" content={robots} />}
		<title>{title}</title>
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="Austen">
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:url" content={pageUrl}>
		<meta property="og:image" content={socialImageUrl}>
		<meta property="og:image:type" content={preview.type}>
		<meta property="og:image:width" content={String(preview.width)}>
		<meta property="og:image:height" content={String(preview.height)}>
		<meta property="og:image:alt" content={socialImageAlt}>
		<meta name="twitter:card" content="summary">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={socialImageUrl}>
		<meta name="twitter:image:alt" content={socialImageAlt}>
		<link
			rel="preload"
			href={cormorantGaramond600}
			as="font"
			type="font/woff2"
			crossorigin
		>
		<link rel="icon" href={`${base}favicon.ico`}>
		<link rel="icon" type="image/svg+xml" sizes="any" href={`${base}logo.svg`}>
		<link rel="sitemap" href="/sitemap-index.xml">
		<link rel="canonical" href={pageUrl}>
		<ClientRouter />
		{structuredData.map((data) => (
				<script
					is:inline
					type="application/ld+json"
					set:html={serializeStructuredData(data)}
				/>
			))}
	</head>
	<body>
		<header class="site-header container">
			<a href={base} class="brand" aria-label="Austen home">
				<img
					src={`${base}logo.svg`}
					alt=""
					class="brand-mark"
					width="64"
					height="64"
				>
				<span class="brand-copy">
					<span class="brand-name">Austen</span>
				</span>
			</a>
			<nav aria-label="Main navigation">
				<a href={`${base}maps/`} aria-current={currentNav("maps")}>Maps</a
				><a href={`${base}authors/`} aria-current={currentNav("authors")}
					>Authors</a
				><a href={`${base}contact/`} aria-current={currentNav("contact")}
					>Contact</a
				><a href="https://github.com/herol3oy/austen/">GitHub</a>
			</nav>
		</header>
		<main class="container"><slot /></main>
		<footer class="container">
			<p class="footer-row">
				<small>Austen {yearLabel}</small>
				<small>Built in Warsaw, Poland</small>
			</p>
		</footer>
	</body>
</html>
