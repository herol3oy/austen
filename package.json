{
	"name": "austen",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "node --test tests/authors.test.mjs tests/diagram.test.mjs tests/generation.test.mjs tests/genres.test.mjs tests/library.test.mjs tests/sitemap.test.mjs tests/worker.test.mjs",
		"test:browser": "node --test tests/browser.test.mjs",
		"worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
		"worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource/cormorant-garamond": "5.3.0",
		"@fontsource/inter": "5.3.0",
		"@panzoom/panzoom": "4.6.2",
		"astro": "^7.3.2",
		"cheerio": "1.2.0",
		"lz-string": "1.5.0",
		"mermaid": "12.0.0",
		"sharp": "0.35.4"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@biomejs/biome": "2.5.13",
		"puppeteer": "25.10.0",
		"typescript": "6.0.3",
		"wrangler": "4.131.0"
	},
	"packageManager": "pnpm@12.3.4"
}
